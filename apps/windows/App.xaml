<Application x:Class="Tickytacky.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3EBDD"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF6EC"/>
    <SolidColorBrush x:Key="SurfaceInkBrush" Color="#FFFCF6"/>
    <SolidColorBrush x:Key="InkBrush" Color="#2A2622"/>
    <SolidColorBrush x:Key="InkMutedBrush" Color="#7A7268"/>
    <SolidColorBrush x:Key="RuleBrush" Color="#D4CBBA"/>
    <SolidColorBrush x:Key="SageBrush" Color="#7FAF98"/>
    <SolidColorBrush x:Key="KraftBrush" Color="#C4A882"/>
    <SolidColorBrush x:Key="KraftSoftBrush" Color="#EDE3D2"/>
    <SolidColorBrush x:Key="SageSoftBrush" Color="#E2F0E8"/>
    <SolidColorBrush x:Key="InkFaintBrush" Color="#A39A8E"/>
    <SolidColorBrush x:Key="OverdueBrush" Color="#C47A6C"/>
    <SolidColorBrush x:Key="OnKraftBrush" Color="#2E261C"/>
    <SolidColorBrush x:Key="OnSageBrush" Color="#1F2E28"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SageBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource OnSageBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceInkBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
  </Application.Resources>
</Application>
