// Example secrets — copy to Secrets.xcconfig (gitignored) and fill in.
// Then point Xcode / project.yml at Secrets.xcconfig or override SUPABASE_* build settings.
//
// SUPABASE_URL = https://xxxx.supabase.co
// SUPABASE_ANON_KEY = eyJ...
//
// Sign in with Apple also needs the Apple provider enabled in the Supabase
// dashboard (Services ID / bundle ID, key, team). Simulator sign-in may fail
// without a paid team — local CRUD still works signed out.
//
// --- Google Calendar bridge ---
// Create an iOS OAuth client in Google Cloud Console, enable Calendar API,
// then uncomment and fill. Scope used: https://www.googleapis.com/auth/calendar
// See Domain/CalendarBridge/CalendarBridge.md and READY_CHECKLIST.md.
//
// GOOGLE_CALENDAR_CLIENT_ID = YOUR_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com
// GOOGLE_CALENDAR_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_IOS_OAUTH_CLIENT_ID
// GOOGLE_CALENDAR_SERVER_CLIENT_ID = YOUR_OPTIONAL_WEB_CLIENT_ID.apps.googleusercontent.com
//
// The reversed client id is registered as a URL scheme in Info.plist for
// ASWebAuthenticationSession OAuth callbacks.

SUPABASE_URL = YOUR_SUPABASE_URL
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

GOOGLE_CALENDAR_CLIENT_ID = YOUR_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CALENDAR_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_IOS_OAUTH_CLIENT_ID
